{
  "_comment": "Bluesky accounts and searches that scripts/social-leads.mjs scans, and the web searches (x) that find X posts for its --x option, for job and award leads (TASKS/jobs.md and TASKS/grants.md, 'Social-media leads'). Posts are leads only: every record needs its official page. Add an account only after reading its profile; an impostor account wastes a run but cannot put facts in the data.",
  "jobs": {
    "queries": [
      "\"tenure-track\" \"computer science\"",
      "\"faculty position\" \"computer science\"",
      "\"faculty positions\" computing",
      "\"assistant professor\" \"computer science\" hiring",
      "\"we are hiring\" faculty \"computer science\"",
      "\"open rank\" \"computer science\"",
      "\"teaching professor\" \"computer science\"",
      "\"lecturer\" \"computer science\" hiring",
      "postdoc \"computer science\" hiring",
      "\"faculty search\" CS",
      "\"faculty hiring\" ECE",
      "\"faculty positions\" \"information science\"",
      "#academicjobs \"computer science\"",
      "#facultyjobs computing"
    ],
    "x": {
      "_comment": "Web searches (restrict results to x.com and twitter.com) whose status URLs the routine passes with --x. Results mix in old posts; the script drops those outside --days.",
      "searches": [
        "\"tenure-track\" \"computer science\" hiring",
        "\"we're hiring\" faculty \"computer science\"",
        "\"faculty positions\" computing \"apply by\"",
        "\"assistant professor\" \"computer science\" \"is hiring\"",
        "\"teaching faculty\" OR \"teaching professor\" \"computer science\" hiring",
        "postdoc position \"computer science\" apply",
        "#FacultyHiring computer science",
        "#CSJobs faculty"
      ]
    },
    "accounts": [
      { "handle": "tenuretracker.bsky.social", "note": "Bot that reposts university job ads: 'X is hiring: <title>', with a tenuretracker.info link to follow to the official ad.", "queries": ["\"computer science\"", "computing", "\"software engineering\"", "\"data science\"", "informatics", "\"artificial intelligence\"", "cybersecurity", "\"electrical and computer engineering\""] }
    ]
  },
